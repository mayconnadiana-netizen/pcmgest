{
  "version": 2,
  "functions": {
    "api/s360/[...path].js": {
      "runtime": "nodejs24.x",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/s360/(.*)",
      "dest": "/api/s360/[...path].js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
